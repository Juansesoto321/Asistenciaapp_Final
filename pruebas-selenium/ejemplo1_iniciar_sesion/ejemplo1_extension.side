{
  "id": "16472876-c443-455b-bf44-f090640b9de5",
  "version": "2.0",
  "name": "AsistenciaApp - Ejemplo 1",
  "url": "https://asistenciaapp-nvj4.onrender.com",
  "tests": [
    {
      "id": "38972199-39e0-4111-bc91-b711b928fb61",
      "name": "Ejemplo 1 - Iniciar sesion",
      "commands": [
        {
          "id": "3ba98890-7c68-4406-862b-4c637b73e09b",
          "comment": "1. Abrir el link de la aplicación",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "6067a6ed-6409-496d-9a7e-ecb4a32e807c",
          "comment": "",
          "command": "setWindowSize",
          "target": "1366x768",
          "targets": [],
          "value": ""
        },
        {
          "id": "042bf296-5ef5-41f2-a74e-6fdc85378770",
          "comment": "Render gratis puede tardar ~1 minuto en despertar",
          "command": "waitForElementVisible",
          "target": "id=login-correo",
          "targets": [],
          "value": "90000"
        },
        {
          "id": "856f8f00-54dc-4aab-8a25-5e34223ae70a",
          "comment": "Espera 2 segundos (2000 ms) para que se vea cada paso",
          "command": "pause",
          "target": "2000",
          "targets": [],
          "value": ""
        },
        {
          "id": "0fcc2780-c676-4061-929f-f6950d26cacc",
          "comment": "2. Escribir el correo del coordinador",
          "command": "type",
          "target": "id=login-correo",
          "targets": [],
          "value": "admin@sena.edu.co"
        },
        {
          "id": "f195efe7-91c8-46c3-88d2-8cfb888bb120",
          "comment": "",
          "command": "pause",
          "target": "2000",
          "targets": [],
          "value": ""
        },
        {
          "id": "bd2fbfab-4de1-40e6-8551-5f981d7eb283",
          "comment": "3. Escribir la contraseña",
          "command": "type",
          "target": "id=login-contrasena",
          "targets": [],
          "value": "Admin123*"
        },
        {
          "id": "b060c70a-fee0-4092-8add-e27fae7bc16f",
          "comment": "",
          "command": "pause",
          "target": "2000",
          "targets": [],
          "value": ""
        },
        {
          "id": "0c74e30a-b4d1-4037-b49e-99cda93a6d10",
          "comment": "4. Clic en Iniciar sesión",
          "command": "click",
          "target": "css=button[type=\"submit\"]",
          "targets": [],
          "value": ""
        },
        {
          "id": "982880ca-e83b-44ce-a6ed-b8366fb831b1",
          "comment": "5. Entró al panel: el saludo lleva su nombre",
          "command": "waitForElementVisible",
          "target": "xpath=//h1[contains(.,'Coordinador')]",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "031d4eb6-65dc-45eb-ac24-b797ba8b7995",
          "comment": "",
          "command": "assertElementPresent",
          "target": "xpath=//h1[contains(.,'Coordinador')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "5a34962d-3584-4e8d-99be-43c1a97e831f",
          "comment": "",
          "command": "pause",
          "target": "2000",
          "targets": [],
          "value": ""
        },
        {
          "id": "2e1e0bd3-d431-4b8f-a614-f763aa92ae41",
          "comment": "",
          "command": "echo",
          "target": "PRUEBA SUPERADA: el coordinador inició sesión y llegó al panel",
          "targets": [],
          "value": ""
        }
      ]
    }
  ],
  "suites": [
    {
      "id": "b057ece4-b1fb-46b7-a831-ab178810cf91",
      "name": "AsistenciaApp - Ejemplo 1",
      "persistSession": false,
      "parallel": false,
      "timeout": 300,
      "tests": [
        "38972199-39e0-4111-bc91-b711b928fb61"
      ]
    }
  ],
