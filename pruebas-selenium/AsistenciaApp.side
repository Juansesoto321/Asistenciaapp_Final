          "comment": "8. Clic en Crear ficha",
          "command": "click",
          "target": "xpath=//button[text()='Crear ficha']",
          "targets": [],
          "value": ""
        },
        {
          "id": "214bfcba-0ce6-4504-9c2f-d5ba307ad517",
