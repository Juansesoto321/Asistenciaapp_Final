          "command": "waitForElementVisible",
          "target": "xpath=//td/b[text()='${numeroFicha}']",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "58acaf9c-bdf1-4cff-aadc-207e3a304be7",
